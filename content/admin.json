    {
      "id": "month",
      "title": "月の準備をする",
      "summary": "日程を決めて、承認し、予定表を公開するまで",
      "steps": [
        {
          "shot": "shots/admin/ad-month-01.webp",
          "instruction": "管理アプリを開くと、この画面から始まります",
          "note": {
            "type": "info",
            "text": "左がカレンダー、右が作業の入口です。月の切り替えは左上の年月から行います。"
          }
        },
        {
          "shot": "shots/admin/ad-month-02.webp",
          "instruction": "上の帯で、いまどの段階かが分かります",
          "note": {
            "type": "info",
            "text": "日程設定 → 設定完了 → 承認 → 予定表公開 → 受付 → シフト作成 → 確認 → シフト公開、の順に進みます。"
          },
          "hotspots": [
            {
              "x": 0.0125,
              "y": 0.1256,
              "w": 0.7861,
              "h": 0.0795
            }
          ]
        },
        {
          "shot": "shots/admin/ad-month-03.webp",
          "instruction": "はじめに、申込開始・締切・シフト公開の日を決めます",
          "hotspots": [
            {
              "x": 0.0097,
              "y": 0.8207,
              "w": 0.7917,
              "h": 0.1807
            }
          ]
        },
        {
          "shot": "shots/admin/ad-month-04.webp",
          "instruction": "次に、その月にPWを行う日と時間帯を決めます",
          "hotspots": [
            {
              "x": 0.0097,
              "y": 0.7569,
              "w": 0.7917,
              "h": 0.228
            }
          ]
        },
        {
          "shot": "shots/admin/ad-month-05.webp",
          "instruction": "決め終わったら承認します",
          "note": {
            "type": "warn",
            "text": "承認すると、申込開始日になった時点で予定表が自動で公開されます。承認前は公開されません。"
