{
  "version": 1,
  "description": "アプリの変更箇所とマニュアル撮影対象の対応表。画面に影響する変更はここへ影響フラグを追加する。",
  "audiences": {
    "volunteer": { "sourceRepo": "shift-form", "recipe": "recipes/volunteer.json" },
    "responsible": { "sourceRepo": "shift-form", "recipe": "recipes/responsible.json" },
    "accountant": { "sourceRepo": "shift-form", "recipe": "recipes/accountant.json" },
    "admin": { "sourceRepo": "admin", "recipe": "recipes/admin.json" }
  },
  "flags": [
    {
      "id": "shift-form.login",
      "label": "ログイン・初回登録",
      "requiresManual": true,
      "sources": [{ "path": "login.html" }, { "path": "js/login.js" }, { "path": "js/session.js" }],
      "targets": [{ "audience": "volunteer", "task": "login" }]
    },
    {
