      "targets": [{ "audience": "admin", "task": "month" }]
    },
    {
      "id": "admin.shift",
      "label": "シフト作成・公開",
      "requiresManual": true,
      "sources": [{ "path": "shift-create.html", "anchors": ["mtab-wish", "mtab-create"] }, { "path": "js/shift-create.js", "anchors": ["mtab-wish", "mtab-create", "publish-btn"] }, { "path": "js/shift-score.js", "anchors": ["score"] }, { "path": "css/shift-create.css", "anchors": ["publish-btn"] }],
      "targets": [{ "audience": "admin", "task": "shift" }]
